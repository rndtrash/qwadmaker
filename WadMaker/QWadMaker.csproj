<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>QWadMaker.Program</StartupObject>
    <AssemblyVersion>1.4.1</AssemblyVersion>
    <FileVersion>1.4.1</FileVersion>
    <Version>1.4.1</Version>
    <Title>WadMaker</Title>
    <Authors>Pieter Witvoet, Ivan Kuzmenko</Authors>
    <Company></Company>
    <Product>QWadMaker</Product>
    <Description>A command-line tool that can turn directories that contain images into Quake 1 WAD files.</Description>
    <Copyright>Copyright © Pieter Witvoet 2021, Ivan Kuzmenko 2026</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>
